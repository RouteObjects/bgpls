        <mxCell id="default" value="FRR-only profile&#10;&#10;configs/frr/{rr1,rr2,p1,p2,edge-frr}.conf&#10;→ native FRR kind startup-config&#10;configs/relay/start.sh + haproxy.cfg&#10;→ relay interfaces + :11790 listener" style="rounded=1;whiteSpace=wrap;html=0;arcSize=10;fillColor=#e9f5fc;strokeColor=#1673a8;strokeWidth=1.5;fontColor=#142c3c;fontFamily=Helvetica;fontSize=18;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="430" width="650" height="210" as="geometry" />
        </mxCell>
        <mxCell id="ceos" value="FRR + cEOS profile&#10;&#10;configs/ceos-profile/{rr1,rr2,p1,p2}.conf&#10;configs/frr/edge-frr.conf&#10;configs/ceos-profile/edge-ceos.cfg&#10;configs/ceos-profile/relay-start.sh + haproxy.cfg" style="rounded=1;whiteSpace=wrap;html=0;arcSize=10;fillColor=#fff3df;strokeColor=#b76a10;strokeWidth=1.5;fontColor=#142c3c;fontFamily=Helvetica;fontSize=18;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="730" y="430" width="670" height="210" as="geometry" />
        </mxCell>
        <mxCell id="nativekind" value="Containerlab owns runtime startup&#10;frr: bgpd + isisd, generated /etc/frr configuration&#10;arista_ceos: Ethernet interface mapping + startup config&#10;HAProxy: interface setup, then raw TCP proxy" style="rounded=1;whiteSpace=wrap;html=0;arcSize=10;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#142c3c;fontFamily=Helvetica;fontSize=18;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="690" width="650" height="155" as="geometry" />
        </mxCell>
        <mxCell id="guards" value="Use the project lifecycle scripts&#10;verify.sh owns temporary collectors and captures&#10;churn-link.sh changes both p1/p2 eth3 endpoints&#10;destroy.sh removes only the recorded deployment" style="rounded=1;whiteSpace=wrap;html=0;arcSize=10;fillColor=#ffffff;strokeColor=#cbd5e1;strokeWidth=1.5;fontColor=#142c3c;fontFamily=Helvetica;fontSize=18;spacing=10;" vertex="1" parent="1">
          <mxGeometry x="730" y="690" width="670" height="155" as="geometry" />
        </mxCell>
        <mxCell id="title" value="Configuration ownership" style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=30;fontColor=#142c3c;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="28" width="1360" height="44" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Run scripts from the repository. Configure fresh external copies; retain ownership records and evidence." style="text;html=0;whiteSpace=wrap;align=left;verticalAlign=middle;rounded=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=16;fontColor=#64748b;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="1360" height="42" as="geometry" />
        </mxCell>
        <mxCell id="foot" value="Profiles share the name bgpls and are alternatives. Never edit a recorded deployment to switch profiles.&#10;Management connectivity comes from each YAML mgmt section; data links come from its links list.&#10;Use VS Code for topology, node terminals, and logs; keep guarded scripts in charge of lifecycle." style="text;html=0;whiteSpace=wrap;align=center;verticalAlign=middle;rounded=0;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=18;fontColor=#142c3c;fontStyle=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="1360" height="85" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
